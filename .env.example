# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_PASSWORD=your_secure_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wordsearch
SPRING_DATASOURCE_USERNAME=wordsearch_user

# In production (e.g. Render — see DEPLOYMENT.md), the DB connection comes from either a
# full SPRING_DATASOURCE_URL or the individual DB_HOST/DB_PORT/DB_NAME parts:
#   DB_HOST=...   DB_PORT=5432   DB_NAME=wordsearch
#   SPRING_DATASOURCE_USERNAME=...   SPRING_DATASOURCE_PASSWORD=...

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_change_this_in_production_minimum_256_bits

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Docker Registry (for CI/CD)
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# SonarCloud (optional, for code quality)
SONAR_TOKEN=your_sonar_token

# Application Configuration
SPRING_PROFILES_ACTIVE=production

# Server Configuration
SERVER_PORT=8080

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_if_using_sentry

# Email Configuration (optional, for notifications)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@example.com
SPRING_MAIL_PASSWORD=your_email_password
